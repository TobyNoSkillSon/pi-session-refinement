{
  "name": "pi-session-refinement",
  "version": "0.1.0",
  "description": "Chronological, session-local refinement memory for long-running Pi conversations.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "session-memory",
    "compaction",
    "refinement"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "prompts",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0 <1",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <1",
    "@earendil-works/pi-tui": ">=0.83.0 <1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typebox": "1.3.7",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TobyNoSkillSon/pi-session-refinement.git"
  },
  "homepage": "https://github.com/TobyNoSkillSon/pi-session-refinement#readme",
  "bugs": {
    "url": "https://github.com/TobyNoSkillSon/pi-session-refinement/issues"
  }
}
