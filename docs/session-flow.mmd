flowchart LR
    transcript[(Raw session JSONL)]
    tail[New conversation interval]
    examiner[Isolated examiner]
    candidate[Stage new checkpoint]
    threshold{Candidate reaches 80%?}
    select[Select oldest legal whole-record prefix]
    consolidator[Isolated consolidator
sees selected prefix only]
    rolled[Rolled candidate
consolidated base + exact suffix + new checkpoint]
    direct[Candidate below threshold]
    generation[Write and hash immutable generation]
    pointer[Atomically publish state.json pointer]
    full[Fresh prompt, resume, fork, compaction, or rebuild
loads full generation]
    overlay[Immediate post-compaction continuation
gets exact new checkpoint only]

    transcript --> tail
    tail --> examiner
    examiner --> candidate
    candidate --> threshold
    threshold -- no --> direct
    direct --> generation
    threshold -- yes --> select
    select --> consolidator
    consolidator --> rolled
    rolled --> generation
    generation --> pointer
    pointer --> full
    pointer -. when Pi continues immediately .-> overlay
